<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- ===================================================== -->
    <!--                     Train Types                        -->
    <!-- ===================================================== -->

    <vType id="G" vClass="rail" length="80" maxSpeed="83.3"
           accel="1.0" decel="1.5" sigma="0.3" minGap="5"
           color="1,0,0" guiShape="rail"/>

    <vType id="D" vClass="rail" length="100" maxSpeed="69.4"
           accel="0.9" decel="1.3" sigma="0.3" minGap="5"
           color="0,0,1" guiShape="rail"/>

    <vType id="Z" vClass="rail" length="140" maxSpeed="55.6"
           accel="0.7" decel="1.1" sigma="0.3" minGap="5"
           color="0,1,0" guiShape="rail"/>

    <vType id="K" vClass="rail" length="160" maxSpeed="44.4"
           accel="0.5" decel="0.9" sigma="0.3" minGap="5"
           color="1,0.5,0" guiShape="rail"/>


    <!-- ===================================================== -->
    <!--                 Up Direction A -> B                   -->
    <!-- ===================================================== -->

    <route id="up_p1"
           edges="A_up_approach A_up_in_1 A_p1_up A_up_out_1 Up_line B_up_in_1 B_p1_up B_up_out_1 B_up_depart"/>

    <route id="up_p2"
           edges="A_up_approach A_up_in_2 A_p2_up A_up_out_2 Up_line B_up_in_2 B_p2_up B_up_out_2 B_up_depart"/>

    <route id="up_p3"
           edges="A_up_approach A_up_in_3 A_p3_up A_up_out_3 Up_line B_up_in_3 B_p3_up B_up_out_3 B_up_depart"/>


    <!-- ===================================================== -->
    <!--                Down Direction B -> A                  -->
    <!-- ===================================================== -->

    <route id="down_p1"
           edges="B_down_approach B_down_in_1 B_p1_down B_down_out_1 Down_line A_down_in_1 A_p1_down A_down_out_1 A_down_depart"/>

    <route id="down_p2"
           edges="B_down_approach B_down_in_2 B_p2_down B_down_out_2 Down_line A_down_in_2 A_p2_down A_down_out_2 A_down_depart"/>

    <route id="down_p3"
           edges="B_down_approach B_down_in_3 B_p3_down B_down_out_3 Down_line A_down_in_3 A_p3_down A_down_out_3 A_down_depart"/>


    <!-- ===================================================== -->
    <!--          Vehicles sorted by depart time (SUMO req)    -->
    <!-- ===================================================== -->

    <!-- K641 : A->B p3, A站长停 -->
    <vehicle id="K641"
             type="K"
             route="up_p3"
             depart="0"
             departLane="best"
             departSpeed="max"/>

    <!-- G1408 : B->A p2 -->
    <vehicle id="G1408"
             type="G"
             route="down_p2"
             depart="90"
             departLane="best"
             departSpeed="max"/>

    <!-- D133 : A->B p1 -->
    <vehicle id="D133"
             type="D"
             route="up_p1"
             depart="120"
             departLane="best"
             departSpeed="max"/>

    <!-- G5050 : A->B p2, pass-through -->
    <vehicle id="G5050"
             type="G"
             route="up_p2"
             depart="180"
             departLane="best"
             departSpeed="max"/>

    <!-- G5060 : B->A p3 -->
    <vehicle id="G5060"
             type="G"
             route="down_p3"
             depart="240"
             departLane="best"
             departSpeed="max"/>

    <!-- K667 : A->B p2 -->
    <vehicle id="K667"
             type="K"
             route="up_p2"
             depart="300"
             departLane="best"
             departSpeed="max"/>

    <!-- Z386 : B->A p1 -->
    <vehicle id="Z386"
             type="Z"
             route="down_p1"
             depart="360"
             departLane="best"
             departSpeed="max"/>

    <!-- K1666 : B->A p2 -->
    <vehicle id="K1666"
             type="K"
             route="down_p2"
             depart="480"
             departLane="best"
             departSpeed="max"/>

    <!-- ===================================================== -->
    <!--          CONFLICT TEST TRAIN (Step 0)                 -->
    <!--  K999: A->B p1, depart 120s, same slot as D133.     -->
    <!--  Priority 3 vs D133 priority 1 -> K999 loses, gets   -->
    <!--  fallback to another platform.  Keep COMMENTED for   -->
    <!--  normal operation; uncomment to test fallback.       -->
    <!-- ===================================================== -->

    <vehicle id="K999"
             type="K"
             route="up_p1"
             depart="120"
             departLane="best"
             departSpeed="max"/>

    <!--
    Stops are NOT hardcoded in .rou.xml.
    Layer 3 Executor controls dwell dynamically via TraCI,
    using dwell_min from timetable_layer1.yaml.
    -->

</routes>
